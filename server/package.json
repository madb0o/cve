{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "backfill": "tsx scripts/backfill.ts",
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql && cp src/nvd/cweCategories.json dist/nvd/cweCategories.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.3.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.7.3"
  }
}
